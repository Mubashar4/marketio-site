---
// src/pages/contact.astro
// Contact page — Marketio.net. Every page drives to a discovery call.
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const ctaHref = 'https://calendly.com/mubashar_ali/mubashar';
---

<BaseLayout
  title="Contact — Marketio"
  description="Connect with Marketio to deploy autonomous AI BDR and SDR agents for your agency. Book a discovery call or send an enquiry."
  path="/contact/"
>
  <Navbar />

  <main id="main" class="pt-32 pb-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <!-- Header -->
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-black px-3 py-1 text-xs font-medium uppercase tracking-wider text-white/60">
          <span class="h-1.5 w-1.5 rounded-full bg-orange"></span>
          Connect with Marketio
        </p>
        <span class="sr-only">Contact</span>
        <h1 class="text-balance text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">
          Let's run your pipeline <span class="text-orange">on autopilot</span>.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/70">
          Ready to deploy AI-driven SDR infrastructure under your own brand or to scale your agency's client volume? Reach out directly.
        </p>
      </div>

      <!-- Split Layout: Book Call and Contact/Form Info -->
      <div class="mx-auto mt-20 grid max-w-5xl gap-12 lg:grid-cols-12">
        <!-- Call Booking (Left / Priority Column) -->
        <article class="rounded-2xl border border-white/10 bg-black p-8 lg:col-span-5 flex flex-col justify-between">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-white">Book a Discovery Call</h2>
            <p class="mt-4 text-sm leading-relaxed text-white/60">
              Skip the back-and-forth. Select a time on our calendar to audit your current outreach pipelines, spam metrics, and operational goals.
            </p>
            <ul class="mt-8 space-y-4 text-sm text-white/80">
              <li class="flex items-center gap-3">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-orange/10 text-orange font-bold text-xs" aria-hidden="true">✓</span>
                <span>Complete backend audit</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-orange/10 text-orange font-bold text-xs" aria-hidden="true">✓</span>
                <span>AI SDR/BDR mapping</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-orange/10 text-orange font-bold text-xs" aria-hidden="true">✓</span>
                <span>Zero-data-loss CRM sync review</span>
              </li>
            </ul>
          </div>
          <div class="mt-10">
            <a
              href={ctaHref}
              target="_blank"
              rel="noopener"
              class="block w-full text-center rounded-xl bg-orange px-6 py-4 font-semibold text-white shadow-lg shadow-orange/25 transition-transform duration-200 hover:scale-[1.02]"
            >
              Choose a Time Slot →
            </a>
          </div>
        </article>

        <!-- Form & General Inquiries (Right Column) -->
        <section aria-labelledby="form-heading" class="rounded-2xl border border-white/10 bg-black p-8 lg:col-span-7">
          <h2 id="form-heading" class="text-2xl font-bold tracking-tight text-white mb-2">Send an Enquiry</h2>
          <p class="text-sm text-white/50 mb-8">
            Prefer text? Fill out our agency scope planner below, or email us at <a href="mailto:hello@marketio.net" class="text-orange hover:underline">hello@marketio.net</a>.
          </p>

          <form action="https://formspree.io/f/placeholder" method="POST" class="space-y-6">
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-white/50">Full Name</label>
                <input
                  type="text"
                  name="name"
                  id="name"
                  required
                  class="mt-2 w-full rounded-xl border border-white/10 bg-charcoal px-4 py-3 text-sm text-white focus:border-orange focus:ring-1 focus:ring-orange"
                  placeholder="Alex Carter"
                />
              </div>
              <div>
                <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-white/50">Work Email</label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  class="mt-2 w-full rounded-xl border border-white/10 bg-charcoal px-4 py-3 text-sm text-white focus:border-orange focus:ring-1 focus:ring-orange"
                  placeholder="alex@agency.com"
                />
              </div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="url" class="block text-xs font-semibold uppercase tracking-wider text-white/50">Agency Website</label>
                <input
                  type="url"
                  name="url"
                  id="url"
                  required
                  class="mt-2 w-full rounded-xl border border-white/10 bg-charcoal px-4 py-3 text-sm text-white focus:border-orange focus:ring-1 focus:ring-orange"
                  placeholder="https://agency.com"
                />
              </div>
              <div>
                <label for="volume" class="block text-xs font-semibold uppercase tracking-wider text-white/50">Current Monthly Output</label>
                <select
                  name="volume"
                  id="volume"
                  class="mt-2 w-full rounded-xl border border-white/10 bg-charcoal px-4 py-3 text-sm text-white focus:border-orange focus:ring-1 focus:ring-orange"
                >
                  <option value="under-10k">< 10k messages / mo</option>
                  <option value="10k-50k">10k – 50k messages / mo</option>
                  <option value="50k-100k">50k – 100k messages / mo</option>
                  <option value="over-100k">100k+ messages / mo</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-white/50">Scope Details</label>
              <textarea
                name="message"
                id="message"
                rows="4"
                required
                class="mt-2 w-full rounded-xl border border-white/10 bg-charcoal px-4 py-3 text-sm text-white focus:border-orange focus:ring-1 focus:ring-orange"
                placeholder="Briefly run through your goals or deliverability bottlenecks..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded-xl border border-orange px-6 py-3.5 text-center text-sm font-semibold text-orange hover:bg-orange hover:text-white transition-all duration-200"
            >
              Send Message
            </button>
          </form>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

---
// src/pages/blog/index.astro
// The Blueprint — blog index page. Placeholder until content collections are wired.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const ctaHref = 'https://app.synclead.io/Mubashar/marketio-power-team';

// PLACEHOLDER(content): Replace with Astro content collection queries once
// src/content/blog/ posts exist. For now, static seed posts demonstrate layout.
const posts = [
  {
    slug: '#',
    title: 'Why Your Cold Email Infrastructure Is Costing You Meetings',
    excerpt: 'Most agencies treat deliverability as an afterthought. Here\'s the infrastructure checklist that separates 95% inbox placement from the spam folder.',
    category: 'Deliverability',
    date: 'Coming Soon',
  },
  {
    slug: '#',
    title: 'AI SDRs vs. Human SDRs: A Real Cost Comparison',
    excerpt: 'We break down the true cost-per-meeting of a 3-person SDR team versus autonomous AI agents — including ramp time, management overhead, and scale ceiling.',
    category: 'AI Agents',
    date: 'Coming Soon',
  },
  {
    slug: '#',
    title: 'The Zero-Data-Loss CRM Sync Problem (And How to Solve It)',
    excerpt: 'When leads move from outbound sequencer to CRM, context disappears. Here\'s the architecture that preserves every touchpoint.',
    category: 'Pipeline',
    date: 'Coming Soon',
  },
  {
    slug: '#',
    title: 'SPF, DKIM, DMARC: The DNS Setup Nobody Gets Right',
    excerpt: 'A technical teardown of the authentication stack behind inbox placement. Includes the exact records we configure for every agency client.',
    category: 'Deliverability',
    date: 'Coming Soon',
  },
  {
    slug: '#',
    title: 'How to Evaluate an AI Outbound Provider',
    excerpt: 'Not all AI SDR tools are created equal. The questions you should ask before committing — from token architecture to reply classification accuracy.',
    category: 'AI Agents',
    date: 'Coming Soon',
  },
  {
    slug: '#',
    title: 'Building a White-Label Outbound Backend for Your Agency',
    excerpt: 'How to offer deliverability and AI-powered outreach under your own brand without building the infrastructure from scratch.',
    category: 'White-Label',
    date: 'Coming Soon',
  },
];
---

<BaseLayout
  title="The Blueprint — Marketio Blog"
  description="Technical teardowns on email deliverability, AI SDR agents, pipeline architecture, and outbound infrastructure. Built for agency operators."
  path="/blog/"
>
  <Navbar />

  <main id="main" class="pt-32 pb-24">
    <!-- Hero -->
    <section class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/10 bg-black px-3 py-1 text-xs font-medium uppercase tracking-wider text-white/60">
          <span class="h-1.5 w-1.5 rounded-full bg-orange"></span>
          The Blueprint
        </p>
        <h1 class="text-balance text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">
          Technical teardowns for <span class="text-orange">agency operators</span>.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-white/70">
          Deep dives into email deliverability engineering, AI agent architecture, and the infrastructure that runs autonomous outbound pipelines.
        </p>
      </div>
    </section>

    <!-- Posts Grid -->
    <section aria-labelledby="posts-heading" class="mx-auto max-w-7xl px-6 pt-20 lg:px-8">
      <h2 id="posts-heading" class="sr-only">Articles</h2>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="group flex flex-col rounded-2xl border border-white/10 bg-black p-6 transition-colors duration-300 hover:border-orange/50">
            <div class="flex items-center gap-3 mb-4">
              <span class="rounded-full border border-white/10 bg-charcoal px-3 py-0.5 text-xs font-medium text-white/60">
                {post.category}
              </span>
              <span class="text-xs text-white/30">{post.date}</span>
            </div>
            <h3 class="text-lg font-bold leading-snug group-hover:text-orange transition-colors duration-200">
              {post.slug === '#' ? post.title : (
                <a href={`/blog/${post.slug}/`}>{post.title}</a>
              )}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-white/60">
              {post.excerpt}
            </p>
            {post.slug !== '#' && (
              <a
                href={`/blog/${post.slug}/`}
                class="mt-4 text-sm font-semibold text-orange hover:underline"
              >
                Read more →
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- Newsletter / CTA -->
    <section class="mx-auto max-w-7xl px-6 pt-24 lg:px-8">
      <div class="rounded-3xl border border-white/10 bg-black/40 px-6 py-16 text-center sm:px-12 sm:py-20">
        <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-white">
          Want these teardowns in your inbox?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-white/60">
          We publish deep technical content for agency operators building outbound at scale. No fluff. No weekly spam.
        </p>
        <div class="mt-8">
          <a
            href={ctaHref}
            target="_blank"
            rel="noopener"
            class="inline-block rounded-xl bg-orange px-8 py-4 text-lg font-semibold shadow-xl shadow-orange/25 transition-transform duration-200 hover:scale-[1.04]"
          >
            Book a Discovery Call →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

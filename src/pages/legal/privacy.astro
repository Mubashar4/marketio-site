---
// src/pages/legal/privacy.astro
// Privacy Policy legal page.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const sections = [
  { id: 'introduction', title: '1. Introduction' },
  { id: 'information-we-collect', title: '2. Information We Collect' },
  { id: 'how-we-use-your-information', title: '3. How We Use Your Information' },
  { id: 'legal-basis-for-processing', title: '4. Legal Basis for Processing (EEA/UK Users)' },
  { id: 'how-we-share-your-information', title: '5. How We Share Your Information' },
  { id: 'data-retention', title: '6. Data Retention' },
  { id: 'cookies-and-tracking', title: '7. Cookies and Tracking' },
  { id: 'data-security', title: '8. Data Security' },
  { id: 'international-data-transfers', title: '9. International Data Transfers' },
  { id: 'your-rights', title: '10. Your Rights' },
  { id: 'children-s-privacy', title: '11. Children\'s Privacy' },
  { id: 'contact-us', title: '12. Contact Us' },
];
---

<BaseLayout
  title="Privacy Policy — Marketio"
  description="Marketio Privacy Policy. Learn how we collect, process, and protect your information when using the Marketio platform."
  path="/legal/privacy/"
  robots="noindex,follow"
>
  <Navbar />

  <main id="main" class="pt-32 pb-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <!-- Header -->
        <div class="border-b border-white/10 pb-8">
          <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Privacy Policy</h1>
          <p class="mt-4 text-sm text-white/50 flex flex-wrap gap-x-6 gap-y-2">
            <span><strong>Effective Date:</strong> March 11, 2026</span>
            <span><strong>Last Updated:</strong> March 11, 2026</span>
            <span><strong>Contact:</strong> <a href="mailto:privacy@marketio.net" class="text-orange hover:underline">privacy@marketio.net</a></span>
          </p>
        </div>

        <!-- Layout with Table of Contents and Content Grid -->
        <div class="mt-12 lg:grid lg:grid-cols-[250px_1fr] lg:gap-12">
          <!-- Sidebar Contents -->
          <aside class="hidden lg:block">
            <div class="sticky top-24">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-white/40">Contents</h2>
              <nav class="mt-4" aria-label="Table of contents">
                <ul class="space-y-3">
                  {sections.map((s) => (
                    <li>
                      <a
                        href={`#${s.id}`}
                        class="text-sm text-white/60 transition-colors duration-200 hover:text-orange focus:text-orange block"
                      >
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </aside>

          <!-- Document Flow -->
          <div class="text-white/80 space-y-12 max-w-2xl lg:max-w-none">
            <!-- Mobile contents list -->
            <nav class="block lg:hidden border border-white/10 bg-black/40 rounded-xl p-6 mb-8" aria-label="Table of contents menu">
              <h2 class="text-sm font-semibold uppercase tracking-wider text-white/50 mb-3">Contents</h2>
              <ul class="grid gap-2 sm:grid-cols-2">
                {sections.map((s) => (
                  <li>
                    <a href={`#${s.id}`} class="text-sm text-orange hover:underline block">
                      {s.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>

            <!-- 1. Introduction -->
            <section id="introduction" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">1. Introduction</h2>
              <p class="leading-relaxed">
                Welcome to Marketio (“Company,” “we,” “us,” or “our”). Marketio LLC is a Delaware Limited Liability Company. We operate the website <a href="https://marketio.net" class="text-orange hover:underline">marketio.net</a> and the Marketio platform (collectively, the “Services”). This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use our Services.
              </p>
              <p class="leading-relaxed">
                For privacy-related inquiries, contact us at: <a href="mailto:privacy@marketio.net" class="text-orange hover:underline">privacy@marketio.net</a>
              </p>
            </section>

            <!-- 2. Information We Collect -->
            <section id="information-we-collect" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">2. Information We Collect</h2>
              
              <div class="space-y-4">
                <div>
                  <h3 class="text-base font-semibold text-white">2.1 Information You Provide Directly</h3>
                  <p class="mt-1 leading-relaxed">
                    We collect information you voluntarily provide when you register for an account, subscribe to our Services, fill out a contact or demo request form, or communicate with us. This may include: full name, email address, company name, job title, phone number, and billing information.
                  </p>
                </div>

                <div>
                  <h3 class="text-base font-semibold text-white">2.2 Information Collected Automatically</h3>
                  <p class="mt-1 leading-relaxed">
                    When you access our Services, we automatically collect device information, log data (IP address, pages visited), usage data, and cookies and similar tracking technologies.
                  </p>
                </div>

                <div>
                  <h3 class="text-base font-semibold text-white">2.3 Information from Third Parties</h3>
                  <p class="mt-1 leading-relaxed">
                    We may receive information from CRM platforms you connect to Marketio, LinkedIn and email providers, analytics providers (Google Analytics), and payment processors (Stripe).
                  </p>
                </div>

                <div>
                  <h3 class="text-base font-semibold text-white">2.4 Prospect Data Processed on Your Behalf</h3>
                  <p class="mt-1 leading-relaxed">
                    As a data processor, Marketio may process personal data about third-party individuals (prospects) on behalf of our customers. Customers are the data controllers for such data. We process this data strictly in accordance with our Terms of Service and applicable Data Processing Agreements.
                  </p>
                </div>
              </div>
            </section>

            <!-- 3. How We Use Your Information -->
            <section id="how-we-use-your-information" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">3. How We Use Your Information</h2>
              <p class="leading-relaxed">
                We use the information we collect to: provide and maintain the Services; process transactions and manage subscriptions; send administrative and marketing communications; improve and personalise the Services; detect and prevent fraud; comply with legal obligations; and respond to your enquiries.
              </p>
            </section>

            <!-- 4. Legal Basis for Processing -->
            <section id="legal-basis-for-processing" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">4. Legal Basis for Processing (EEA/UK Users)</h2>
              <p class="leading-relaxed">
                If you are located in the EEA or UK, we process your personal data on the following legal bases:
              </p>
              <ul class="list-disc list-inside space-y-2 pl-4">
                <li><strong class="text-white">Performance of a contract:</strong> To provide the Services you subscribed to</li>
                <li><strong class="text-white">Legitimate interests:</strong> To improve our Services and prevent fraud</li>
                <li><strong class="text-white">Consent:</strong> Where you have explicitly opted in</li>
                <li><strong class="text-white">Legal obligation:</strong> Where required by law</li>
              </ul>
            </section>

            <!-- 5. How We Share Your Information -->
            <section id="how-we-share-your-information" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">5. How We Share Your Information</h2>
              <p class="leading-relaxed">
                We do not sell your personal information. We may share it with:
              </p>
              <ul class="list-disc list-inside space-y-2 pl-4">
                <li><strong class="text-white">Service Providers:</strong> AWS (hosting), Stripe (payments), Anthropic (AI processing), analytics platforms. These providers are contractually obligated to protect your data.</li>
                <li><strong class="text-white">Business Transfers:</strong> In connection with a merger or acquisition, with prior notice.</li>
                <li><strong class="text-white">Legal Requirements:</strong> Where required by law or to protect rights and safety.</li>
              </ul>
            </section>

            <!-- 6. Data Retention -->
            <section id="data-retention" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">6. Data Retention</h2>
              <ul class="list-disc list-inside space-y-2 pl-4">
                <li><strong class="text-white">Account data:</strong> Duration of subscription plus 2 years</li>
                <li><strong class="text-white">Billing records:</strong> 7 years (financial regulations)</li>
                <li><strong class="text-white">Support communications:</strong> 3 years</li>
                <li><strong class="text-white">Marketing data:</strong> Until you unsubscribe or withdraw consent</li>
              </ul>
              <p class="leading-relaxed mt-4">
                You may request deletion at any time by emailing <a href="mailto:privacy@marketio.net" class="text-orange hover:underline">privacy@marketio.net</a>.
              </p>
            </section>

            <!-- 7. Cookies and Tracking -->
            <section id="cookies-and-tracking" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">7. Cookies and Tracking</h2>
              <p class="leading-relaxed">
                We use essential, analytics, and marketing cookies. You can manage your preferences at any time via our Cookie Preferences centre. See our <a href="/legal/cookie/" class="text-orange hover:underline">Cookie Policy</a> for full details.
              </p>
            </section>

            <!-- 8. Data Security -->
            <section id="data-security" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">8. Data Security</h2>
              <p class="leading-relaxed">
                We implement commercially reasonable security measures including encryption of data in transit (TLS/SSL) and at rest, access controls, multi-factor authentication, and regular security assessments. See our <a href="/legal/security/" class="text-orange hover:underline">Security</a> page for full details.
              </p>
            </section>

            <!-- 9. International Data Transfers -->
            <section id="international-data-transfers" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">9. International Data Transfers</h2>
              <p class="leading-relaxed">
                Marketio operates globally and may transfer your data to the United States and other countries. We ensure transfers comply with applicable data protection laws, including through Standard Contractual Clauses (SCCs) where applicable.
              </p>
            </section>

            <!-- 10. Your Rights -->
            <section id="your-rights" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">10. Your Rights</h2>
              <p class="leading-relaxed">
                Depending on your jurisdiction, you may have the right to: access, correct, delete, or port your data; restrict or object to processing; and withdraw consent. To exercise these rights, contact <a href="mailto:privacy@marketio.net" class="text-orange hover:underline">privacy@marketio.net</a>. We will respond within 30 days.
              </p>
            </section>

            <!-- 11. Children's Privacy -->
            <section id="children-s-privacy" class="scroll-mt-24 space-y-4">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">11. Children's Privacy</h2>
              <p class="leading-relaxed">
                Our Services are not directed to individuals under 16. We do not knowingly collect data from children. If you believe a child has provided us with data, contact <a href="mailto:privacy@marketio.net" class="text-orange hover:underline">privacy@marketio.net</a>.
              </p>
            </section>

            <!-- 12. Contact Us -->
            <section id="contact-us" class="scroll-mt-24 space-y-4 border-t border-white/10 pt-8">
              <h2 class="text-xl font-bold tracking-tight text-white sm:text-2xl">12. Contact Us</h2>
              <p class="leading-relaxed">
                Marketio LLC (Delaware Limited Liability Company)<br />
                Email: <a href="mailto:privacy@marketio.net" class="text-orange hover:underline">privacy@marketio.net</a><br />
                Website: <a href="https://marketio.net" class="text-orange hover:underline">marketio.net</a>
              </p>
            </section>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

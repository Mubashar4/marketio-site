---
// Navbar — fixed top bar. Pure HTML/CSS; no JS drawer (details/summary pattern).
const links = [
  { href: '/deliverability/', label: 'Deliverability' },
  { href: '/ai-automation/', label: 'AI Growth Engine' },
  { href: '/pipeline-sync/', label: 'Pipeline Sync' },
  { href: '/blog/', label: 'Blueprint' },
];
const ctaHref = 'https://calendly.com/mubashar_ali/mubashar';
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-white/5 bg-charcoal/80 backdrop-blur">
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2" aria-label="Marketio home">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-orange" aria-hidden="true"></span>
      <span class="text-lg font-bold tracking-tight">Marketio</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-8 md:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="text-sm text-white/70 transition-colors duration-200 hover:text-white">
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href={ctaHref}
        target="_blank"
        rel="noopener"
        class="hidden rounded-lg bg-orange px-4 py-2 text-sm font-semibold text-white transition-transform duration-200 hover:scale-[1.03] md:inline-block"
      >
        Book a Discovery Call →
      </a>

      <!-- Mobile menu: native details, zero JS -->
      <details class="relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-white/10 [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h14" stroke="#FAFAFA" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-xl border border-white/10 bg-black p-2 shadow-xl">
          <ul>
            {links.map((l) => (
              <li>
                <a href={l.href} class="block rounded-lg px-3 py-2 text-sm text-white/80 hover:bg-white/5 hover:text-white">
                  {l.label}
                </a>
              </li>
            ))}
            <li class="mt-1 border-t border-white/10 pt-1">
              <a href={ctaHref} target="_blank" rel="noopener" class="block rounded-lg bg-orange px-3 py-2 text-sm font-semibold text-white">
                Book a Discovery Call →
              </a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

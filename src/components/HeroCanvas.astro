---
// HeroCanvas — interactive "Autonomous Agent Pipeline" node graph (specs/brand.md Motion).
// Pipeline: Prospect → Engage → Book → Close.
// Orange nodes = active agent stages (Engage, Book); white edges = data-flow paths.
// Zero dependencies. Script < 8KB unminified (specs/architecture.md budget).
---

<section aria-label="Marketio autonomous agent pipeline diagram" class="relative">
  <div class="overflow-hidden rounded-2xl border border-white/10 bg-black shadow-[0_0_80px_-20px_rgba(255,85,0,0.25)]">
    <canvas id="agent-pipeline" class="block h-auto w-full" width="960" height="600" role="img"
      aria-label="Animated diagram: AI agents move prospects through Prospect, Engage, Book and Close stages autonomously">
    </canvas>

    <!-- Stage labels — below canvas to avoid node overlap -->
    <div class="flex items-center justify-between border-t border-white/5 px-[4%] py-2.5 sm:px-[6%]">
      <span class="text-[10px] font-semibold uppercase tracking-widest text-white/40 sm:text-xs">Prospect</span>
      <span class="text-[10px] font-semibold uppercase tracking-widest text-orange/70 sm:text-xs">Engage</span>
      <span class="text-[10px] font-semibold uppercase tracking-widest text-orange/70 sm:text-xs">Book</span>
      <span class="text-[10px] font-semibold uppercase tracking-widest text-white/40 sm:text-xs">Close</span>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById('agent-pipeline') as HTMLCanvasElement | null;

  if (canvas && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const W = canvas.width;
      const H = canvas.height;
      const ORANGE = '#FF5500';
      const WHITE = '#FAFAFA';
      const DIM = 'rgba(250,250,250,0.28)';
      let raf = 0;
      let t = 0;
      let mx = -1e3;
      let my = -1e3;

      // ---- Topology: 4 stage columns of nodes (Prospect / Engage / Book / Close) ----
      type Node = { x: number; y: number; r: number; stage: number };
      const nodes: Node[] = [];
      const colX = [W * 0.14, W * 0.38, W * 0.62, W * 0.86];
      const colYs: number[][] = [
        [H * 0.2, H * 0.5, H * 0.8],
        [H * 0.35, H * 0.65],
        [H * 0.2, H * 0.5, H * 0.8],
        [H * 0.35, H * 0.65],
      ];
      colX.forEach((x, s) =>
        colYs[s].forEach((y) => nodes.push({ x, y, r: s === 1 ? 13 : 9, stage: s })),
      );

      // Edges connect each node to every node in the next stage.
      const edges: Array<[number, number]> = [];
      for (const a of nodes)
        for (const b of nodes)
          if (b.stage === a.stage + 1) edges.push([nodes.indexOf(a), nodes.indexOf(b)]);

      // ---- Packets travelling along edges -------------------------------------
      type Packet = { e: number; p: number; v: number };
      const packets: Packet[] = [];
      function spawn() {
        if (packets.length > 26 || !edges.length) return;
        packets.push({
          e: Math.floor(Math.random() * edges.length),
          p: 0,
          v: 0.004 + Math.random() * 0.006,
        });
      }

      function draw() {
        t += 1;
        ctx!.clearRect(0, 0, W, H);

        // Edges
        for (const [ai, bi] of edges) {
          const a = nodes[ai];
          const b = nodes[bi];
          ctx!.strokeStyle = DIM;
          ctx!.lineWidth = 1;
          ctx!.beginPath();
          ctx!.moveTo(a.x, a.y);
          const cx = (a.x + b.x) / 2;
          ctx!.bezierCurveTo(cx, a.y, cx, b.y, b.x, b.y);
          ctx!.stroke();
        }

        // Packets (orange dots with fading trail)
        spawn();
        spawn();
        for (let i = packets.length - 1; i >= 0; i--) {
          const pk = packets[i];
          pk.p += pk.v;
          if (pk.p >= 1) {
            packets.splice(i, 1);
            continue;
          }
          const [ai, bi] = edges[pk.e];
          const a = nodes[ai];
          const b = nodes[bi];
          const u = pk.p;
          const x = (1 - u) ** 3 * a.x + 3 * (1 - u) ** 2 * u * ((a.x + b.x) / 2) +
            3 * (1 - u) * u ** 2 * ((a.x + b.x) / 2) + u ** 3 * b.x;
          const y = (1 - u) ** 3 * a.y + 3 * (1 - u) ** 2 * u * a.y +
            3 * (1 - u) * u ** 2 * b.y + u ** 3 * b.y;
          ctx!.fillStyle = ORANGE;
          ctx!.globalAlpha = Math.sin(u * Math.PI);
          ctx!.beginPath();
          ctx!.arc(x, y, 3, 0, Math.PI * 2);
          ctx!.fill();
          ctx!.globalAlpha = 1;
        }

        // Nodes — pulse via sin(t); brighten near pointer
        for (const n of nodes) {
          const pulse = 1 + 0.08 * Math.sin((t + n.x) / 24);
          const dxm = mx - n.x;
          const dym = my - n.y;
          const near = dxm * dxm + dym * dym < 120 * 120;
          const r = n.r * pulse;
          ctx!.beginPath();
          ctx!.arc(n.x, n.y, r, 0, Math.PI * 2);
          ctx!.fillStyle = near ? ORANGE : 'rgba(250,250,250,0.16)';
          ctx!.fill();
          ctx!.lineWidth = 1.5;
          ctx!.strokeStyle = near ? ORANGE : DIM;
          ctx!.stroke();

          // Active-agent ring on Engage (stage 1) and Book (stage 2) columns
          if (n.stage === 1 || n.stage === 3) {
            ctx!.beginPath();
            ctx!.arc(n.x, n.y, r + 6 + 2 * Math.sin(t / 18), 0, Math.PI * 2);
            ctx!.strokeStyle = 'rgba(255,85,0,0.35)';
            ctx!.lineWidth = 1;
            ctx!.stroke();
          }
        }

        raf = requestAnimationFrame(draw);
      }

      canvas.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mx = ((e.clientX - rect.left) / rect.width) * W;
        my = ((e.clientY - rect.top) / rect.height) * H;
      });
      canvas.addEventListener('pointerleave', () => {
        mx = -1e3;
        my = -1e3;
      });

      draw();
      // ponytail: no visibilitychange pause needed — static site, single hero instance;
      // add IntersectionObserver pause only if more canvases land.
    }
  }
</script>
